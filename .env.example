# ---------------------------------------------------------------------------
# Environment switch and database
# ---------------------------------------------------------------------------
PROD=false
COLLECTOR_DB_URL=postgresql+psycopg2://user:password@localhost:5432/macrobond_inhouse

COLLECTOR_LOG_LEVEL=INFO
COLLECTOR_RAW_DIR=_raw
COLLECTOR_VENDOR_SERIES_FILE=config/vendor_series.csv
COLLECTOR_HISTORY_START=1990-01-01

# ---------------------------------------------------------------------------
# Licensed delivery provider
#
# BRC is the publisher. Bloomberg and LSEG are the licensed routes to its data.
# DATA_PROVIDER supplies the canonical history and is the only provider whose
# values are stored.
#
# FALLBACK_PROVIDER is used ONLY when the primary is unreachable (library
# missing, Terminal/Workspace not running, timeout). It is never used for an
# entitlement failure or an unknown identifier, because both mean the
# configuration is wrong and failing over would hide that.
#
# CROSS_CHECK_PROVIDER is read and compared but never written. A disagreement
# beyond CROSS_CHECK_TOLERANCE (in the published unit, i.e. percentage points)
# fails the run rather than silently persisting one vendor's numbers.
#
# Leave the last two empty for a single-provider desk.
# ---------------------------------------------------------------------------
DATA_PROVIDER=bloomberg
FALLBACK_PROVIDER=
CROSS_CHECK_PROVIDER=
CROSS_CHECK_TOLERANCE=0.05

# ---------------------------------------------------------------------------
# Bloomberg Desktop API
#
# There is no secret here and none should ever be added. The Desktop API
# authenticates through the Terminal session already logged in on this machine.
# These two settings exist only because some desks move the local service port.
# ---------------------------------------------------------------------------
BLOOMBERG_HOST=localhost
BLOOMBERG_PORT=8194

# ---------------------------------------------------------------------------
# LSEG Data Library
#
# A desktop session authenticates through a running LSEG Workspace, so there is
# no secret here either. A desk on a platform session instead configures the
# library's own lseg-data.config.json and points LD_LIB_CONFIG_PATH at it; the
# app key lives in that file, which is gitignored, and never in this one.
# ---------------------------------------------------------------------------
LSEG_SESSION=desktop.workspace
# LD_LIB_CONFIG_PATH=

# ---------------------------------------------------------------------------
# Databricks / Azure Key Vault (PROD only)
# ---------------------------------------------------------------------------
DBX_SERVER_HOSTNAME=
DBX_HTTP_PATH=
AKV_VAULT_URL=
AKV_SECRET_NAME=databricks-token
DATABRICKS_TOKEN=
